# Pooled connection used by the running app.
# Neon on Vercel injects this. Locally it can match DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beacon?schema=public"

# Direct connection used by Prisma db push. Neon injects DATABASE_URL_UNPOOLED.
# For Docker or a local Postgres server, set this to the same URL as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/beacon?schema=public"

# Required. Production refuses to start unless this is at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="replace-with-a-random-string-at-least-32-chars"

# Public origin. Local dev is http. Vercel is https://<project>.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Beacon does not use product analytics. This also turns off Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
