# SQLite file lives next to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Replace before any shared or deployed use. At least 32 characters.
JWT_SECRET="dev-only-change-me-please-use-32-chars"

# Used by `next start` / hosting. Local dev uses http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Beacon does not use product analytics. This also turns off Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
